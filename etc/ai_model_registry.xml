<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:MageSetu_AiBase:etc/ai_model_registry.xsd">

    <!-- OpenAI -->
    <provider code="openai" label="OpenAI">

        <model name="gpt-5.5" label="gpt-5.5">
            <type>chat</type>
            <token_param>max_completion_tokens</token_param>
            <supports_reasoning_effort>true</supports_reasoning_effort>
            <default_reasoning_effort>medium</default_reasoning_effort>
            <supports_verbosity>true</supports_verbosity>
            <supports_temperature>false</supports_temperature>
            <context_window>1050000</context_window>
            <capabilities>
                <capability>chat</capability>
                <capability>reasoning</capability>
            </capabilities>
            <reasoning_effort_values>
                <value>none</value>
                <value>low</value>
                <value>medium</value>
                <value>high</value>
                <value>xhigh</value>
            </reasoning_effort_values>
        </model>

        <model name="gpt-5.4" label="gpt-5.4">
            <type>chat</type>
            <token_param>max_completion_tokens</token_param>
            <supports_reasoning_effort>true</supports_reasoning_effort>
            <default_reasoning_effort>none</default_reasoning_effort>
            <supports_verbosity>true</supports_verbosity>
            <supports_temperature>false</supports_temperature>
            <context_window>1050000</context_window><!-- up to 1.05M with config; surcharge above 272K -->
            <capabilities>
                <capability>chat</capability>
                <capability>reasoning</capability>
            </capabilities>
            <reasoning_effort_values>
                <value>none</value>
                <value>low</value>
                <value>medium</value>
                <value>high</value>
                <value>xhigh</value>
            </reasoning_effort_values>
        </model>

