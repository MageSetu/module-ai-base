                <value>none</value>
                <value>low</value>
                <value>medium</value>
                <value>high</value>
                <value>xhigh</value>
            </reasoning_effort_values>
        </model>

        <!-- context_window omitted: not confirmed -->
        <model name="gpt-5.2-instant" label="gpt-5.2-instant">
            <type>chat</type>
            <token_param>max_completion_tokens</token_param>
            <supports_reasoning_effort>false</supports_reasoning_effort>
            <supports_verbosity>false</supports_verbosity>
            <supports_temperature>true</supports_temperature>
            <capabilities>
                <capability>chat</capability>
            </capabilities>
        </model>

        <!-- context_window omitted: not confirmed -->
        <model name="gpt-4.1" label="gpt-4.1">
